# ══════════════════════════════════════════════════════════════════════════
#  Grow Farms API — production settings for growfarm-fullstack.dvworks.in
#
#  Copy this to backend/.env ON THE SERVER (or paste the values into the
#  hosting panel's Node.js environment editor) and fill in the two secrets
#  marked CHANGE ME. Never commit the filled-in file.
# ══════════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
API_PREFIX=/api

# Public origin of this backend — the scheme + domain a browser reaches it on,
# with NO /api on the end. The code appends API_PREFIX itself when it builds
# image URLs, so uploaded images come out as
#   https://growfarm-fullstack.dvworks.in/api/uploads/projects/x.jpg
# which is the one path the host actually routes to this process.
PUBLIC_URL=https://growfarm-fullstack.dvworks.in

# ─── MySQL ─────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=growfarms
DB_USER=growfarms
DB_PASSWORD=CHANGE ME — the live database password
DB_LOGGING=false

# ─── JWT ───────────────────────────────────────────────────────────────────
# CHANGE ME. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to boot in production if this is under 32 characters.
# Replacing it signs every admin out once; they just log in again.
JWT_SECRET=CHANGE ME — 96 hex characters from the command above
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────────────
# The website and the panel are same-origin with the API, so the browser never
# sends a cross-origin request and this list is not what makes the site work.
# It is still set correctly so that anything else pointed at this API is an
# explicit decision rather than an accident.
CORS_ORIGINS=https://growfarm-fullstack.dvworks.in

# ─── Uploads ───────────────────────────────────────────────────────────────
# Served at both /uploads and /api/uploads; production traffic uses the latter.
# The web server's body-size limit must exceed MAX_UPLOAD_SIZE_MB
# (nginx: client_max_body_size 10M).
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ─── Seed admin (created by npm run db:seed) ───────────────────────────────
# Change the password from inside the panel after the first sign-in.
SEED_ADMIN_NAME=Grow Farms Admin
SEED_ADMIN_EMAIL=admin@growfarms.com
SEED_ADMIN_PASSWORD=Admin@12345

# ─── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
ENQUIRY_RATE_LIMIT_MAX=20
