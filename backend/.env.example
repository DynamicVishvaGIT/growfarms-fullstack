# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Public origin of this backend - scheme + domain only, no /api on the end.
# Image URLs are built as PUBLIC_URL + API_PREFIX + /uploads/..., because in
# production only /api/* is routed to this process. See .env.production.example
# for the live values.
PUBLIC_URL=http://localhost:5000

# ─── MySQL ─────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=growfarms
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# ─── JWT ───────────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma separated list of allowed origins (frontend + admin panel).
# In production the site, the panel and the API share one domain, so this is
# a single entry and no request is actually cross-origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ─── Seed admin (created by npm run db:seed) ───────────────────────────────
SEED_ADMIN_NAME=Grow Farms Admin
SEED_ADMIN_EMAIL=admin@growfarms.com
SEED_ADMIN_PASSWORD=Admin@12345

# ─── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
ENQUIRY_RATE_LIMIT_MAX=20
