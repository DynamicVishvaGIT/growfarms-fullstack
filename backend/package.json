{
  "name": "growfarms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + Express + MySQL backend for the Grow Farms website and admin panel",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:seed": "node src/scripts/seed.js",
    "db:sync": "node src/scripts/syncTables.js",
    "db:reset": "node src/scripts/migrate.js --force && node src/scripts/seed.js",
    "test:routes": "node smoke.test.cjs",
    "test:audit": "node audit.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
