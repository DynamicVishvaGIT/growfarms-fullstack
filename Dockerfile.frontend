FROM node:20-alpine AS build

WORKDIR /app

# Main website dependencies
COPY package*.json ./
RUN npm ci

# Admin dependencies
COPY admin/package*.json ./admin/
RUN cd admin && npm ci

# Source code
COPY . .

# Production API URL
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Build main website
RUN npm run build

# Build admin panel
RUN cd admin && npm run build


# =========================
# Production Nginx
# =========================
FROM nginx:alpine

# Main website
COPY --from=build /app/dist /usr/share/nginx/html

# Admin panel
COPY --from=build /app/admin/dist /usr/share/nginx/html/admin

# Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
