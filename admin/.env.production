# Production build values for the Grow Farms admin panel.
#
# Vite loads this file automatically for `npm run build` and it wins over .env,
# so a build can no longer ship the localhost value from .env and leave the
# panel unable to reach the server ("Could not reach the server").
#
# Relative on purpose: the panel is served from the same domain as the API
# (https://growfarm-fullstack.dvworks.in/admin -> .../api), so this resolves
# against the page's own origin and stays correct if the domain changes.
VITE_API_URL=/api

# Target of the "View site" link in the panel header. The public website is the
# root of this same domain, so a relative "/" is right; without it the link
# falls back to http://localhost:5173 and is dead for everyone but a developer.
VITE_SITE_URL=/
