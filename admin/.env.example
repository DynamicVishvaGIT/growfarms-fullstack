# Base URL of the Grow Farms backend API, baked into the bundle at build time.
#
# Development — the API runs on its own port, so this must be absolute:
VITE_API_URL=http://localhost:5000/api

# Where the "View site" link in the panel header points.
VITE_SITE_URL=http://localhost:5173

# Production is handled by admin/.env.production (committed), which sets both
# of these to same-domain relative paths. Do not put production URLs here.
