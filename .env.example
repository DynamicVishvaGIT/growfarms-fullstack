# Base URL of the Grow Farms backend API, baked into the bundle at build time.
#
# Development — the API runs on its own port, so this must be absolute:
VITE_API_URL=http://localhost:5000/api

# Production is handled by .env.production (committed), which sets a relative
# "/api" because the site and the API share one domain. Do not put a production
# URL here: .env is loaded for dev *and* build, and .env.production is what
# wins for `npm run build`.
